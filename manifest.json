{
  "manifest_version": 3,
  "name": "GitHub Enhance",
  "version": "1.0.4",
  "description": "Visually enhance GitHub: absolute dates, sidebar controls, one-click hide-as-outdated, and timeline reordering.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Enhance",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
